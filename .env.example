# Copy this file to .env and fill in real values for local `netlify dev` testing.
# Never commit the real .env file — it is already gitignored.

# Required: secret key for the OpenAI API. Keep this server-side only.
# Configure the real value in the Netlify UI: Site settings > Environment variables.
OPENAI_API_KEY=sk-your-key-here

# Optional: override the default chat model.
OPENAI_MODEL=gpt-4o-mini
