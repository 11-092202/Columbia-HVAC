# Copy this file to .env and fill in real values for local `netlify dev` testing.
# Never commit the real .env file — it is already gitignored.

# Required: secret key for the OpenAI API. Keep this server-side only —
# never referenced from any frontend file (HTML/CSS/JS).
# Configure the real value in the Netlify UI later: Site settings > Environment variables.
OPENAI_API_KEY=sk-your-key-here

# Optional: override the default chat model.
OPENAI_MODEL=gpt-4o-mini

# Chatbot kill switch. Set to false to make the assistant refuse ALL
# requests (POST /api/chat returns 503) and hide the chat widget in the UI.
# Defaults to true (enabled) if unset.
CHATBOT_ENABLED=true

# ---------------------------------------------------------------------------
# Contact form email notifications — OPTIONAL.
# The contact form (POST /api/contact) works and validates/logs every
# submission without any of these set. Set all three to also email a
# notification for each new lead via the Resend API (https://resend.com).
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_your-resend-api-key-here
CONTACT_TO_EMAIL=you@example.com
CONTACT_FROM_EMAIL=leads@yourverifieddomain.com
